<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_fuel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fuel —"
        android:textColor="#FFD100"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Service —"
        android:textColor="#F5F5F5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#F5F5F5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#F5F5F5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#F5F5F5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFD100"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_asof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#9A9A9A"
        android:textSize="12sp" />

    <Button
        android:id="@+id/widget_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFD100"
        android:text="Start ride"
        android:textAllCaps="false"
        android:textColor="#111111"
        android:visibility="gone" />
</LinearLayout>
