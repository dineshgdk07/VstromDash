<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Same exclusions as backup_rules.xml, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bumblebee_nav.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bumblebee_nav.xml" />
    </device-transfer>
</data-extraction-rules>
